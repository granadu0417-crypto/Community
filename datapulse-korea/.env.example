# DataPulse Korea - Environment Variables Example
# 이 파일을 복사하여 .env.local을 만들고 실제 값을 입력하세요

# ======================
# 지도 API
# ======================
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_map_api_key_here
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your_naver_map_client_id_here

# ======================
# 공공데이터 API (Tier 1)
# ======================
# 국토교통부 실거래가
REALESTATE_API_KEY=your_realestate_api_key_here

# 경찰청 범죄 통계
CRIME_API_KEY=your_crime_api_key_here

# 에어코리아 대기질
AIRKOREA_API_KEY=your_airkorea_api_key_here

# 행정안전부 인구 통계
POPULATION_API_KEY=your_population_api_key_here

# ======================
# 공공데이터 API (Tier 2)
# ======================
# 국회 의안정보
ASSEMBLY_API_KEY=your_assembly_api_key_here

# 열린재정
OPENFISCAL_API_KEY=your_openfiscal_api_key_here

# 지방재정365
LOCALFISCAL_API_KEY=your_localfiscal_api_key_here

# ======================
# 공공데이터 API (Tier 3)
# ======================
# 교육부 학교정보
NEIS_API_KEY=your_neis_api_key_here

# 건강보험심사평가원
HIRA_API_KEY=your_hira_api_key_here

# 도로교통공단
TAAS_API_KEY=your_taas_api_key_here

# 문화체육관광부
CULTURE_API_KEY=your_culture_api_key_here

# ======================
# Cloudflare (Production)
# ======================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ======================
# Database
# ======================
# Cloudflare D1 Database ID (Production)
D1_DATABASE_ID=your_d1_database_id_here

# ======================
# KV Storage
# ======================
# Cloudflare KV Namespace ID
KV_NAMESPACE_ID=your_kv_namespace_id_here

# ======================
# Analytics (Optional)
# ======================
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# ======================
# Development
# ======================
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
